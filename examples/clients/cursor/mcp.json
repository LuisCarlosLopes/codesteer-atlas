{
  "mcpServers": {
    "codesteer-atlas": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/LuisCarlosLopes/codesteer-atlas.git",
        "atlas-serve"
      ],
      "env": {
        "ATLAS_INDEX_DIR": "${workspaceFolder}/.code-index",
        "ATLAS_RELEVANCE": "0",
        "ATLAS_RELEVANCE_GATE": "0",
        "ATLAS_CONTEXT_OPTIMIZATION": "0"
      }
    }
  }
}
